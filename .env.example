# Copie este arquivo para .env e preencha os valores. Nunca envie o .env para o git.

# Servidor
PORT=3000
# URL pública do portal, usada no e-mail/WhatsApp de primeiro acesso (ex.: https://portal.n1solucoes.com.br)
APP_URL=

# E-mails da equipe N1, separados por vírgula. Só essas contas abrem a área interna.
# Quem criar conta pela tela de login e não estiver aqui vê "Acesso em análise".
STAFF_EMAILS=voce@exemplo.com,colega@exemplo.com

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sua-service-role-key
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Gmail SMTP (recomendado quando não há domínio próprio de envio)
# Ative a verificação em 2 etapas e crie uma "Senha de app" na Conta Google.
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Resend (opcional, alternativa ao Gmail; exige domínio verificado para destinatários arbitrários)
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave
EMAIL_FROM=N1 Solucoes <no-reply@example.com>

# WhatsApp do link de primeiro acesso:
#   web   = não oficial e gratuito. O número da empresa é conectado pelo QR code que aparece no
#           terminal do servidor. O WhatsApp pode bloquear o número se as mensagens parecerem spam.
#   cloud = API oficial da Meta, configurada logo abaixo.
#   off   = não envia pelo WhatsApp.
WHATSAPP_PROVIDER=web
# Pasta onde a sessão fica salva. Ela vale como estar logado no número: não compartilhe nem envie ao git.
# WHATSAPP_WEB_AUTH_DIR=.whatsapp-auth

# WhatsApp Business Platform (Meta Cloud API) - link de primeiro acesso enviado pelo número corporativo
# 1. Meta Business Suite > WhatsApp Manager: registre o número e copie o "Phone number ID".
# 2. Crie um token permanente (System User com a permissão whatsapp_business_messaging).
# 3. Crie e aprove um template UTILITY em pt_BR com 2 variáveis no corpo:
#    Olá, {{1}}! Seu cadastro na N1 Soluções foi concluído. Pelo link abaixo você cria sua senha,
#    aceita os termos de uso e acompanha o seu processo: {{2}}
#    O link vale por 7 dias e só pode ser usado uma vez.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TEMPLATE=acesso_portal
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_API_VERSION=v23.0
